# Copy to .env and set the password only on the machine running the bot.
# Never add a real password to documentation or the published package.
OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_EXECUTABLE=C:\path\to\opencode.exe
# OPENCODE_SERVER_PASSWORD=replace-with-a-new-secret
# Optional when attaching to an existing shared OpenCode server:
# OPENCODE_SHARED_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SHARED_SERVER_PROJECT=C:\path\to\your-project
# Forward new OpenCode tool images to mapped Discord threads in every project:
# OPENCODE_DISCORD_SYNC_IMAGES=true
