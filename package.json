{
  "name": "open_cord",
  "private": true,
  "version": "1.0.0",
  "description": "OpenCord: local OpenCode CLI v2 to Discord session bridge",
  "repository": "https://github.com/HaYanJongSeong/opencord",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": { "opencord": "dist/src/cli.js" },
  "files": ["dist/src/", "dist/scripts/discord/", "scripts/*.sh", "scripts/start-visible.cmd", "opencord.cmd", "config.example.yaml", ".env.example", "README.md", "LICENSE"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/src/cli.js",
    "dev": "tsx src/cli.ts",
    "setup": "node dist/src/setup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "service:setup": "bash scripts/setup.sh",
    "service:stop": "bash scripts/stop.sh",
    "service:restart": "bash scripts/restart.sh",
    "service:unsetup": "bash scripts/unsetup.sh",
    "service:status": "bash scripts/status.sh",
    "service:restart-detached": "bash scripts/restart-detached.sh",
    "discord:guilds": "node dist/scripts/discord/guilds.js",
    "discord:channels": "node dist/scripts/discord/channels.js",
    "discord:create-channel": "node dist/scripts/discord/createChannel.js",
    "discord:rename-channel": "node dist/scripts/discord/renameChannel.js",
    "discord:ensure-channel": "node dist/scripts/discord/ensureChannel.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.1",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.32",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "cross-spawn": "^7.0.6",
    "discord.js": "^14.26.3",
    "satori": "^0.26.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
